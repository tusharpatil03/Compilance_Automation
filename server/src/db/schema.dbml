enum tenant_status {
  active
  inactive
  suspended
}

enum apikey_status {
  active
  inactive
  revoked
}

enum account_status {
  REGISTERED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum identity_verification_status {
  UNVERIFIED
  IN_PROGRESS
  VERIFIED
  REJECTED
  EXPIRED
}

enum document_status {
  UPLOADED
  PROCESSING
  EXTRACTED
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum verification_stage {
  FORMAT_CHECK
  GOVERNMENT_VERIFICATION
  FACE_MATCH
  LIVENESS_DETECTION
}

enum verification_status {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  MANUAL_REVIEW
}

enum stage_result {
  PENDING
  PASSED
  FAILED
  SKIPPED
}

enum otp_purpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
}

enum otp_channel {
  EMAIL
  SMS
}

enum token_type {
  JWT
  PASETO
}

table identities {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email varchar(255)
  phone_number varchar(20)
  account_status account_status [not null, default: 'REGISTERED']
  verification_status identity_verification_status [not null, default: 'UNVERIFIED']
  trust_score "numeric(5, 2)"
  risk_score "numeric(5, 2)"
  risk_rating varchar(16)
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'identities_email_unique', unique]
    phone_number [name: 'identities_phone_unique', unique]
  }
}

table identity_profiles {
  identity_id uuid [pk, not null]
  full_name varchar(255)
  date_of_birth date
  address_line1 varchar(255)
  address_line2 varchar(255)
  city varchar(100)
  country varchar(2)
  postal_code varchar(20)
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table identity_profile_history {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identity_id uuid [not null]
  field_name varchar(100) [not null]
  old_value text
  new_value text
  changed_by uuid [not null]
  changed_at "timestamp with time zone" [not null, default: `now()`]
}

table identity_status_history {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identity_id uuid [not null]
  status_type varchar(30) [not null]
  from_status varchar(30)
  to_status varchar(30) [not null]
  reason text
  changed_by uuid
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table credentials {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identity_id uuid [not null]
  password_hash text [not null]
  password_updated_at "timestamp with time zone" [not null, default: `now()`]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table otp_codes {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identity_id uuid [not null]
  purpose otp_purpose [not null]
  channel otp_channel [not null]
  code_hash text [not null]
  attempts smallint [not null, default: 0]
  max_attempts smallint [not null, default: 5]
  expires_at "timestamp with time zone" [not null]
  consumed_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table sessions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identity_id uuid [not null]
  token_type token_type [not null]
  token_id varchar(255) [not null, unique]
  issued_at "timestamp with time zone" [not null, default: `now()`]
  expires_at "timestamp with time zone" [not null]
  revoked_at "timestamp with time zone"
  ip_address varchar(64)
  user_agent text
}

table tenants {
  id integer [pk, not null]
  name varchar(255) [not null, unique]
  email varchar(255) [not null, unique]
  password varchar(255) [not null]
  salt varchar(255) [not null]
  status tenant_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table tenants_api_keys {
  id integer [pk, not null]
  tenant_id integer [not null]
  api_key varchar(255) [not null]
  api_key_hash varchar(512) [not null]
  key_prefix varchar(20) [not null]
  status apikey_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  expires_at timestamp
  revoked_at timestamp
  rotated_from_key_id integer

  indexes {
    (tenant_id, key_prefix) [name: 'tenant_keyprefix', unique]
    tenant_id [name: 'ix_tenantapikey_tenant']
  }
}

table event_store {
  id integer [pk, not null]
  tenant_id integer [not null]
  aggregate_id integer [not null]
  event_type varchar(255) [not null]
  payload jsonb [not null]
  metadata jsonb [not null]
  occurred_at timestamp [not null, default: `now()`]
}

table outbox {
  id integer [pk, not null]
  event_id integer [not null]
  event_type varchar(255) [not null]
  tenant_id integer [not null]
  payload jsonb [not null]
  aggregate_id integer [not null]
  metadata jsonb [not null]
  occurred_at timestamp [not null, default: `now()`]
  processed_at timestamp
  processed integer [not null, default: 0]
  retries integer [not null, default: 0]

  indexes {
    (tenant_id, event_type) [name: 'ix_outbox_tenant_event']
    processed_at [name: 'ix_outbox_processed_at']
  }
}

table webhooks {
  id integer [pk, not null]
  tenant_id integer [not null]
  url varchar(2048) [not null]
  events jsonb
  secret varchar(255) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table documents {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identity_id uuid [not null]
  document_type varchar(50) [not null]
  current_version_id uuid
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table document_versions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  document_id uuid [not null]
  version_number integer [not null]
  storage_ref text [not null]
  status document_status [not null, default: 'UPLOADED']
  uploaded_by uuid [not null]
  uploaded_at "timestamp with time zone" [not null, default: `now()`]
}

table document_extractions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  document_version_id uuid [not null]
  extracted_fields jsonb [not null]
  ocr_confidence "numeric(5, 4)"
  processed_at "timestamp with time zone" [not null, default: `now()`]
}

table verifications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identity_id uuid [not null]
  document_id uuid
  status verification_status [not null, default: 'PENDING']
  started_at "timestamp with time zone" [not null, default: `now()`]
  completed_at "timestamp with time zone"
}

table verification_stage_results {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  verification_id uuid [not null]
  stage verification_stage [not null]
  result stage_result [not null, default: 'PENDING']
  details jsonb
  started_at "timestamp with time zone"
  completed_at "timestamp with time zone"

  indexes {
    (verification_id, stage) [name: 'verification_stage_unique', unique]
  }
}

ref identity_profiles_identity_id_identities_id_fk: identity_profiles.identity_id > identities.id [delete: cascade, update: no action]

ref identity_profile_history_identity_id_identities_id_fk: identity_profile_history.identity_id > identities.id [delete: cascade, update: no action]

ref identity_status_history_identity_id_identities_id_fk: identity_status_history.identity_id > identities.id [delete: cascade, update: no action]

ref credentials_identity_id_identities_id_fk: credentials.identity_id > identities.id [delete: cascade, update: no action]

ref otp_codes_identity_id_identities_id_fk: otp_codes.identity_id > identities.id [delete: cascade, update: no action]

ref sessions_identity_id_identities_id_fk: sessions.identity_id > identities.id [delete: cascade, update: no action]

ref tenants_api_keys_tenant_id_tenants_id_fk: tenants_api_keys.tenant_id > tenants.id [delete: no action, update: no action]

ref tenants_api_keys_rotated_from_key_id_tenants_api_keys_id_fk: tenants_api_keys.rotated_from_key_id > tenants_api_keys.id [delete: no action, update: no action]

ref outbox_event_id_event_store_id_fk: outbox.event_id > event_store.id [delete: no action, update: no action]

ref webhooks_tenant_id_tenants_id_fk: webhooks.tenant_id > tenants.id [delete: no action, update: no action]

ref documents_identity_id_identities_id_fk: documents.identity_id > identities.id [delete: cascade, update: no action]

ref document_versions_document_id_documents_id_fk: document_versions.document_id > documents.id [delete: cascade, update: no action]

ref document_versions_uploaded_by_identities_id_fk: document_versions.uploaded_by > identities.id [delete: no action, update: no action]

ref document_extractions_document_version_id_document_versions_id_fk: document_extractions.document_version_id > document_versions.id [delete: cascade, update: no action]

ref verifications_identity_id_identities_id_fk: verifications.identity_id > identities.id [delete: cascade, update: no action]

ref verifications_document_id_documents_id_fk: verifications.document_id > documents.id [delete: no action, update: no action]

ref verification_stage_results_verification_id_verifications_id_fk: verification_stage_results.verification_id > verifications.id [delete: cascade, update: no action]