{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "NODE_ENV=development tsx --watch ./src/server.ts",
    "type-check": "tsc --noEmit",
    "build": "pnpm run type-check && esbuild src/server.ts --bundle --platform=node --outfile=dist/server.js",
    "start": "NODE_ENV=production node ./dist/server.js",
    "db:push": "pnpm exec drizzle-kit push --config ./drizzle.config.ts",
    "db:generate": "pnpm exec drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "NODE_ENV=development pnpm exec drizzle-kit migrate --config ./drizzle.config.ts",
    "db:migrate:prod": "NODE_ENV=production pnpm exec drizzle-kit migrate --config ./drizzle.config.ts",
    "db:generate-dbml": "ts-node scripts/dbml.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "init": "tsx scripts/init.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bull-arena": "^4.9.2",
    "bullmq": "^5.70.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bull-arena": "^3.0.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.5.2",
    "@types/pg": "^8.16.0",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.2.0",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
